# HTTPS automático (Let's Encrypt) para o domínio da API. Sem domínio próprio, use
# <IP-da-VM>.sslip.io (ex.: 152-67-1-2.sslip.io), que já resolve para o IP.
{$TAILORLY_API_DOMAIN} {
	encode zstd gzip

	# Uploads de PDF chegam a 8 MiB; o resto da API é JSON pequeno.
	request_body {
		max_size 10MB
	}

	reverse_proxy api:8080 {
		# Geração de currículo e due diligence chamam IA e podem levar mais de um minuto.
		transport http {
			read_timeout 180s
			write_timeout 180s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
