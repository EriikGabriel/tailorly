# Copie para ~/tailorly/.env na VM (chmod 600). Nunca versione o .env real.

# --- Domínio público da API (o Caddy emite o certificado) ---
# Domínio próprio com registro A para o IP da VM, ou <ip-com-hifens>.sslip.io (ex.: 152-67-1-2.sslip.io).
TAILORLY_API_DOMAIN=api.example.com
# O workflow de deploy grava aqui a tag do commit publicado; ajuste só para fazer rollback manual.
TAILORLY_API_IMAGE=ghcr.io/eriikgabriel/tailorly-api:latest

# --- Banco: Neon ---
# Use o endpoint DIRETO (host sem "-pooler"): Flyway e Hikari usam prepared statements e estado de
# sessão, que o PgBouncer do Neon em modo transaction não preserva.
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/tailorly?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=
# Uma instância precisa de poucas conexões; o Free limita o total.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5

# --- Arquivos: Cloudflare R2 (bucket privado) ---
TAILORLY_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
TAILORLY_STORAGE_REGION=auto
TAILORLY_STORAGE_BUCKET=tailorly-private
TAILORLY_STORAGE_PATH_STYLE=true
TAILORLY_STORAGE_ACCESS_KEY=
TAILORLY_STORAGE_SECRET_KEY=

# --- Segurança ---
# openssl rand -base64 32, um valor diferente para cada. Trocar o JWT derruba as sessões; trocar o
# SECRETS_KEY torna ilegíveis as chaves de IA que as contas salvaram.
TAILORLY_JWT_SECRET=
TAILORLY_SECRETS_KEY=
TAILORLY_JWT_ISSUER=https://api.example.com
TAILORLY_ADMIN_EMAILS=
# Domínio de produção da Vercel e, se quiser, os previews (padrões com * são aceitos).
TAILORLY_CORS_ALLOWED_ORIGINS=https://tailorly.vercel.app,https://tailorly-*.vercel.app
# openssl rand -hex 32
TAILORLY_SEARXNG_SECRET=

# --- IA (extração semântica, análise da vaga, ATS e due diligence) ---
# Qualquer endpoint compatível com Chat Completions (OpenAI, OpenRouter, DeepSeek...). Não há Ollama na
# VM: não use ollama-only nem remote-with-ollama-fallback aqui.
TAILORLY_INTERPRETATION_PROVIDER=remote
TAILORLY_REMOTE_ENDPOINT=https://api.openai.com/v1/chat/completions
TAILORLY_REMOTE_MODEL=
TAILORLY_REMOTE_API_KEY=

# --- Limites de visitantes (opcional; padrões em application.yml) ---
# TAILORLY_ANONYMOUS_MAX_GENERATIONS=3
# TAILORLY_ANONYMOUS_SESSIONS_PER_IP_PER_HOUR=10

# O Second Brain (vault Obsidian) só faz sentido em instalação pessoal: desligado no servidor público.
TAILORLY_VAULT_ENABLED=false
