# API database
DATABASE_URL=jdbc:postgresql://localhost:5432/tailorly
PGHOST=localhost
PGDATABASE=tailorly
PGUSER=tailorly
PGPASSWORD=

# API authentication and access
# TAILORLY_JWT_SECRET is omitted locally to use the development-only profile value.
# Set a Base64 secret of at least 32 bytes outside the local profile.
# TAILORLY_JWT_SECRET=
TAILORLY_JWT_ISSUER=http://localhost:8080
TAILORLY_ADMIN_EMAILS=
# TAILORLY_SECRETS_KEY encrypts AI provider API keys saved per account
# (ai_preferences). Also omitted locally to use the development-only profile
# value; set a strong passphrase outside the local profile.
# TAILORLY_SECRETS_KEY=

# PDF extraction and OCR
TAILORLY_EXTRACTION_ENABLED=true
TAILORLY_TESSERACT_COMMAND=tesseract
TAILORLY_OCR_LANGUAGES=por+eng
TAILORLY_OCR_REVISION=local-1

# Fact interpretation
# provider: rules | remote | remote-with-ollama-fallback | ollama-only | claude-cli | codex-cli (local only, see below)
TAILORLY_INTERPRETATION_PROVIDER=rules
# remote accepts any OpenAI Chat Completions-compatible endpoint: OpenAI, Anthropic, DeepSeek, OpenRouter, etc.
TAILORLY_REMOTE_ENDPOINT=https://api.openai.com/v1/chat/completions
TAILORLY_REMOTE_MODEL=
TAILORLY_REMOTE_API_KEY=
TAILORLY_OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
TAILORLY_OLLAMA_MODEL=qwen3:8b
TAILORLY_OLLAMA_API_KEY=ollama

# Local Claude Code (claude-cli): uses the Claude Code CLI logged in on THIS machine and consumes that
# person's Claude subscription. LOCAL USE ONLY: never enable on a deploy that serves other people.
# When enabled, accounts can pick "Claude Code local" in Profile > AI preferences and adjust model,
# timeout and effort per step there; the values below are the server defaults.
TAILORLY_CLAUDE_CLI_ENABLED=false
TAILORLY_CLAUDE_CLI_COMMAND=claude
# CLI alias (sonnet, opus, haiku) or a full model name
TAILORLY_CLAUDE_CLI_MODEL=sonnet
TAILORLY_CLAUDE_CLI_TIMEOUT=PT3M
# Reasoning effort: low | medium | high | xhigh | max (default for steps without their own value)
TAILORLY_CLAUDE_CLI_EFFORT=medium
# TAILORLY_CLAUDE_CLI_EFFORT_INTERPRETATION=high
# TAILORLY_CLAUDE_CLI_EFFORT_CONTENT_ENRICHMENT=high
# TAILORLY_CLAUDE_CLI_EFFORT_JOB_ANALYSIS=medium
# TAILORLY_CLAUDE_CLI_EFFORT_SUPPLEMENTARY_EVIDENCE=medium
# TAILORLY_CLAUDE_CLI_EFFORT_DUE_DILIGENCE=medium
# TAILORLY_CLAUDE_CLI_EFFORT_ATS_REVIEW=medium
# TAILORLY_CLAUDE_CLI_EFFORT_RESUME_LAYOUT_PLAN=low

# Local Codex (codex-cli): uses the Codex CLI logged in (ChatGPT account) on THIS machine and consumes
# that account's limits. LOCAL USE ONLY: never enable on a deploy that serves other people.
# When enabled, accounts can pick "Codex local" in Profile > AI preferences and adjust model, timeout
# and effort per step there; the values below are the server defaults. Effort "max" becomes "xhigh".
TAILORLY_CODEX_CLI_ENABLED=false
TAILORLY_CODEX_CLI_COMMAND=codex
# Empty = Codex default model
TAILORLY_CODEX_CLI_MODEL=
TAILORLY_CODEX_CLI_TIMEOUT=PT3M
TAILORLY_CODEX_CLI_EFFORT=medium
# TAILORLY_CODEX_CLI_EFFORT_INTERPRETATION=high
# TAILORLY_CODEX_CLI_EFFORT_CONTENT_ENRICHMENT=high
# TAILORLY_CODEX_CLI_EFFORT_JOB_ANALYSIS=medium
# TAILORLY_CODEX_CLI_EFFORT_SUPPLEMENTARY_EVIDENCE=medium
# TAILORLY_CODEX_CLI_EFFORT_DUE_DILIGENCE=medium
# TAILORLY_CODEX_CLI_EFFORT_ATS_REVIEW=medium
# TAILORLY_CODEX_CLI_EFFORT_RESUME_LAYOUT_PLAN=low

# Anonymous access (visitors without an account). They always use the AI configured above.
# TAILORLY_ANONYMOUS_SESSION_TTL=PT24H
# TAILORLY_ANONYMOUS_MAX_FILE_BYTES=3145728
# TAILORLY_ANONYMOUS_MAX_PAGES=3
# TAILORLY_ANONYMOUS_MAX_UPLOADS=3
# TAILORLY_ANONYMOUS_MAX_EXTRACTIONS=3
# TAILORLY_ANONYMOUS_MAX_GENERATIONS=3
# TAILORLY_ANONYMOUS_REQUESTS_PER_MINUTE=300
# TAILORLY_ANONYMOUS_SESSIONS_PER_IP_PER_HOUR=10
# TAILORLY_ANONYMOUS_MAX_ACTIVE_SESSIONS=1000
# TAILORLY_ANONYMOUS_CLEANUP_INTERVAL=PT5M
# TAILORLY_ANONYMOUS_CLEANUP_ENABLED=true

# Resume generation (PDF compiled by the Typst CLI; Markdown needs no external tool)
# Uses the Typst CLI container; dev.sh runs from services/api.
TAILORLY_TYPST_COMMAND=./bin/typst-docker

# Object storage; blank credentials fall back to .env.garage
TAILORLY_STORAGE_ENDPOINT=http://localhost:3900
TAILORLY_STORAGE_REGION=garage
TAILORLY_STORAGE_BUCKET=tailorly-private
TAILORLY_STORAGE_PATH_STYLE=true
# TAILORLY_STORAGE_ACCESS_KEY=
# TAILORLY_STORAGE_SECRET_KEY=

# Enrichment sources (optional, off by default). Each account configures its own Obsidian vault
# and toggles in the profile (Second Brain section); the server only allows folders inside the root.
# TAILORLY_VAULT_ROOT=/home/you/Obsidian
# Exports generated resumes to each account's vault (requires a vault configured in the profile)
# TAILORLY_VAULT_ENABLED=false
# TAILORLY_VAULT_SUBFOLDER=B03 Resources/CVs
# Local SearXNG for web search about projects. Start it with `docker compose up -d searxng` from the repo root.
# TAILORLY_SEARXNG_URL=http://127.0.0.1:8888

# Local supporting tools; these are not required by pnpm dev
TAILORLY_POSTGRES_PORT=5432
TAILORLY_OPENAPI_URL=http://localhost:8080/v3/api-docs

# Optional integration-test database settings
# TAILORLY_TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/tailorly_test
# TAILORLY_TEST_DATABASE_USER=tailorly
# TAILORLY_TEST_DATABASE_PASSWORD=tailorly

# Rate limiting (see docs/security.md). Behind a reverse proxy (Render) set TAILORLY_FORWARD_HEADERS_STRATEGY=native
# so limits use the real client IP; leave it as `none` when running without a proxy.
# TAILORLY_FORWARD_HEADERS_STRATEGY=none
# TAILORLY_RATE_LIMIT_ENABLED=true
# TAILORLY_RATE_LIMIT_AUTH_PER_MINUTE=30
# TAILORLY_RATE_LIMIT_REGISTER_PER_HOUR=10
# TAILORLY_RATE_LIMIT_LOGIN_FAILURES_PER_IP_EMAIL=5
# TAILORLY_RATE_LIMIT_HEAVY_PER_MINUTE=15
