#!/bin/sh

set -eu

if [ -z "${JAVA_HOME:-}" ]; then
  if ! command -v java >/dev/null 2>&1; then
    echo "Java was not found. Install JDK 21 and make sure 'java' is available in PATH." >&2
    exit 1
  fi

  JAVA_BIN="$(readlink -f "$(command -v java)")"
  JAVA_HOME="$(dirname "$(dirname "$JAVA_BIN")")"
  export JAVA_HOME
fi

if [ ! -x "$JAVA_HOME/bin/java" ]; then
  echo "JAVA_HOME does not point to a valid JDK: $JAVA_HOME" >&2
  exit 1
fi

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

if [ -x "${MAVEN_HOME:-}/bin/mvn" ]; then
  exec "$MAVEN_HOME/bin/mvn" "$@"
fi

MAVEN_VERSION=3.9.9
WRAPPER_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/.mvn/wrapper"
MAVEN_HOME="$WRAPPER_DIR/dists/apache-maven-$MAVEN_VERSION"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  mkdir -p "$WRAPPER_DIR/dists"
  ARCHIVE="$WRAPPER_DIR/dists/apache-maven-$MAVEN_VERSION-bin.tar.gz"
  if [ ! -f "$ARCHIVE" ]; then
    curl --fail --location --silent --show-error \
      "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.tar.gz" \
      --output "$ARCHIVE"
  fi
  tar -xzf "$ARCHIVE" -C "$WRAPPER_DIR/dists"
fi

exec "$MAVEN_HOME/bin/mvn" -Dmaven.repo.local="$WRAPPER_DIR/repository" "$@"
