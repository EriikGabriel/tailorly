        "routing": "step",
        "payload": {
          "kind": "sql",
          "content": "INSERT INTO extraction_proposals (\n    extraction_run_id,\n    document_id,\n    proposed_facts,\n    status\n)\nVALUES (\n    :run_id,\n    :document_id,\n    :facts,\n    'PROPOSED'\n);\n\nUPDATE extraction_jobs\nSET status = 'COMPLETED'\nWHERE id = :job_id;"
        },
