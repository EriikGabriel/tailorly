        "routing": "step",
        "payload": {
          "kind": "sql",
          "content": "BEGIN;\n\nINSERT INTO documents (\n    id,\n    owner_id,\n    filename,\n    content_type,\n    file_hash\n)\nVALUES (\n    :document_id,\n    :owner_id,\n    'resume.pdf',\n    'application/pdf',\n    :sha256\n);\n\nINSERT INTO document_versions (\n    document_id,\n    status\n)\nVALUES (\n    :document_id,\n    'CANDIDATE'\n);\n\nINSERT INTO extraction_jobs (\n    document_id,\n    status\n)\nVALUES (\n    :document_id,\n    'QUEUED'\n);\n\nCOMMIT;"
        },
